# Copy to .env and adjust. .env is git-ignored: never commit real keys.
# An empty value counts as "not set".

# --- Application -------------------------------------------------------------------------
APP_NAME=ai-agent-service
APP_ENV=development              # development | test | production: selects the logging profile
# LOG_LEVEL=DEBUG                # optional: overrides the profile's root level
# Debugging only: log prompts, model replies and tool results at DEBUG (development profile).
# Refused when APP_ENV=production. Content may hold personal data: do not share these logs.
LOG_LLM_CONTENT=false
LOG_LLM_CONTENT_MAX_CHARS=2000
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
# Shared key for POST /v1/agent/runs (sent as the X-API-Key header). Required in production.
API_KEY=

# --- MCP tool server ---------------------------------------------------------------------
MCP_SERVER_URL=http://localhost:3000/mcp
MCP_HEALTH_URL=http://localhost:3000/health
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_TOOL_TIMEOUT_SECONDS=30

# --- LLM providers -----------------------------------------------------------------------
# A provider is enabled only when ALL of its variables are set. Model names are examples:
# check each provider's documentation for the ids available to you.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b            # must support tool calling; plain `llama3` does not
# OLLAMA_REASONING=false         # set false to skip "thinking" on reasoning models (faster)

# Key from Google AI Studio. Recommended model: gemini-3.8-flash (stable, function calling,
# built for agents, has a free tier). Cheaper but weaker at multi-step tool use:
# gemini-3.5-flash-lite. Flagship, no free tier: gemini-4-argon. Gemini 3.x returns
# "thought signatures" that must be replayed; ProviderState does that (not yet verified live).
# Do not set the thinking level to "minimal": gemini-3.8-flash rejects it.
# Models and prices change: check https://ai.google.dev/gemini-api/docs/models (checked 2026-11-05).
GEMINI_API_KEY=
GEMINI_MODEL=                    # for example gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                 # for example claude-haiku-5-5 or claude-sonnet-5-5

# Required when more than one provider is enabled.
LLM_DEFAULT_PROVIDER=ollama
# Availability fallback, as JSON: when the key provider is down or rate limited, try these.
# LLM_FALLBACKS={"anthropic": ["ollama"]}

LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8

# --- Agent limits (every run is bounded by all of them) ----------------------------------
AGENT_MAX_PROMPT_LENGTH=4000
AGENT_MAX_STEPS=8
AGENT_MAX_TOTAL_TOKENS=50000
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_IDENTICAL_TOOL_CALLS=2
AGENT_MAX_TOOL_OUTPUT_CHARS=8000
# Comma-separated. Only these tools are offered to the model. Empty = all tools.
# AGENT_TOOL_ALLOWLIST=search_customers,get_ticket_info

# --- OpenTelemetry (OTLP over HTTP) ------------------------------------------------------
OTEL_ENABLED=false
# Base URL of the collector. /v1/traces is appended.
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
